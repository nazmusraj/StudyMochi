void setup() {
  Wire.begin(21, 22); // SDA = 21, SCL = 22
  
  if(!display.begin(0x3C, true)) {
    for(;;); // ডিসপ্লে ইনিশিয়ালাইজ না হলে থামবে
  }

  display.clearDisplay();
  display.display();
}

void loop() {
  // ১. চোখ খোলা রাখা (Random interval: ২ থেকে ৪ সেকেন্ড)
  display.clearDisplay();
  display.drawBitmap(0, 0, epd_bitmap_eyes_open, SCREEN_WIDTH, SCREEN_HEIGHT, SH110X_WHITE);
  display.display();
  delay(random(2000, 4500)); 

  // ২. পলক ফেলা (চোখ বন্ধ: ১৫০ মিলিসেকেন্ড)
  display.clearDisplay();
  display.drawBitmap(0, 0, epd_bitmap_eyes_closed, SCREEN_WIDTH, SCREEN_HEIGHT, SH110X_WHITE);
  display.display();
  delay(150); 

  // ৩. মাঝে মাঝে ডাবল ব্লিংক (Double blink effect)
  if (random(0, 10) > 7) {
    display.clearDisplay();
    display.drawBitmap(0, 0, epd_bitmap_eyes_open, SCREEN_WIDTH, SCREEN_HEIGHT, SH110X_WHITE);
    display.display();
    delay(100);

    display.clearDisplay();
    display.drawBitmap(0, 0, epd_bitmap_eyes_closed, SCREEN_WIDTH, SCREEN_HEIGHT, SH110X_WHITE);
    display.display();
    delay(150);
  }
}