// =========================================================
// 2. String Converter (English to Bangla)
// =========================================================
String getBanglaNumBig(int number) {
  String engNum = String(number);
  if (number < 10) engNum = "0" + engNum;
  
  String banglaNum = "";
  for (int i = 0; i < engNum.length(); i++) {
    char c = engNum[i];
    switch (c) {
      case '0': banglaNum += "০"; break;
      case '1': banglaNum += "১"; break;
      case '2': banglaNum += "২"; break;
      case '3': banglaNum += "৩"; break;
      case '4': banglaNum += "৪"; break;
      case '5': banglaNum += "৫"; break;
      case '6': banglaNum += "৬"; break;
      case '7': banglaNum += "৭"; break;
      case '8': banglaNum += "৮"; break;
      case '9': banglaNum += "৯"; break;
      default: banglaNum += c; break;
    }
  }
  return banglaNum;
}

void setup() {
  Serial.begin(115200);
  Wire.begin(21, 22);

  if(!display.begin(0x3C, true)) {
    Serial.println("SH1106 allocation failed");
    for(;;);
  }

  u8g2Fonts.begin(display);
  u8g2Fonts.setFont(u8g2_font_unifont_t_bengali);
  u8g2Fonts.setFontMode(1);
  u8g2Fonts.setFontDirection(0);
  u8g2Fonts.setForegroundColor(SH110X_WHITE);

  if (!rtc.begin()) {
    display.clearDisplay();
    display.setCursor(10, 30);
    display.print("RTC Not Found!");
    display.display();
    while (1) delay(10);
  }

  // Logic to synchronize RTC with the PC's real-time at upload
  DateTime compiledTime = DateTime(F(__DATE__), F(__TIME__));
  if (rtc.lostPower() || rtc.now().unixtime() < compiledTime.unixtime()) {
    Serial.println("Updating RTC to PC's current time...");
    rtc.adjust(compiledTime);
  }
}

void loop() {
  DateTime now = rtc.now();

  int h12 = now.hour() % 12;
  if (h12 == 0) h12 = 12;
  String ampm = (now.hour() >= 12) ? "PM" : "AM";

  display.clearDisplay();
  display.setTextColor(SH110X_WHITE);
  
  // ==========================================
  // 1. Print Date (Using the same U8g2 Bangla font as the clock!)
  // ==========================================
  String dateStr = getBanglaNumBig(now.day()) + "/" + getBanglaNumBig(now.month()) + "/" + getBanglaNumBig(now.year() % 100);
  int dateWidth = u8g2Fonts.getUTF8Width(dateStr.c_str());
  int dateX = (128 - dateWidth) / 2;
  
  u8g2Fonts.setCursor(dateX, 15); // Set at the very top
  u8g2Fonts.print(dateStr);

  // ==========================================
  // 2. Print Main Time
  // ==========================================
  String timeStr = getBanglaNumBig(h12) + ":" + getBanglaNumBig(now.minute()) + ":" + getBanglaNumBig(now.second());
  int timeWidth = u8g2Fonts.getUTF8Width(timeStr.c_str());
  int totalTimeWidth = timeWidth + 4 + 12; 
  int timeX = (128 - totalTimeWidth) / 2;

  u8g2Fonts.setCursor(timeX, 36); // Centered below the date
  u8g2Fonts.print(timeStr);

  // ==========================================
  // 3. Print AM/PM (To the right of the time)
  // ==========================================
  display.setTextSize(1);
  display.setCursor(timeX + timeWidth + 4, 26); 
  display.print(ampm); 

  // ==========================================
  // 4. Print Day Name (Using your 64x16 bitmap)
  // ==========================================
  int dayIndex = now.dayOfTheWeek(); 
  int dayX = (128 - 64) / 2; 
  display.drawBitmap(dayX, 48, banglaDayBitmaps[dayIndex], 64, 16, SH110X_WHITE);

  display.display();
  delay(1000); 
}