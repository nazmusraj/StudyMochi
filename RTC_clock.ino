// =========================================================
// রেন্ডারিং ফাংশনসমূহ
// =========================================================
int drawSmallDigit(int digit, int x, int y) {
  display.drawBitmap(x, y, small_bangla_digits[digit], 8, 8, SH110X_WHITE);
  return x + 7; 
}

void drawSmallBanglaDate(int d, int m, int y, int startX, int startY) {
  int x = startX;
  if (d < 10) x = drawSmallDigit(0, x, startY);
  else x = drawSmallDigit(d / 10, x, startY);
  x = drawSmallDigit(d % 10, x, startY);
  
  display.drawBitmap(x, startY, small_slash, 8, 8, SH110X_WHITE);
  x += 6;
  
  if (m < 10) x = drawSmallDigit(0, x, startY);
  else x = drawSmallDigit(m / 10, x, startY);
  x = drawSmallDigit(m % 10, x, startY);

  display.drawBitmap(x, startY, small_slash, 8, 8, SH110X_WHITE);
  x += 6;
  
  x = drawSmallDigit(y / 1000, x, startY);
  x = drawSmallDigit((y / 100) % 10, x, startY);
  x = drawSmallDigit((y / 10) % 10, x, startY);
  drawSmallDigit(y % 10, x, startY);
}

String getBanglaNumBig(int number) {
  String engNum = String(number);
  if (number < 10) engNum = "0" + engNum;
  
  String banglaNum = "";
  for (int i = 0; i < engNum.length(); i++) {
    char c = engNum[i];
    switch (c) {
      case '0': banglaNum += "০"; break;
      case '1': banglaNum += "১"; break;
      case '2': banglaNum += "২"; break;
      case '3': banglaNum += "৩"; break;
      case '4': banglaNum += "৪"; break;
      case '5': banglaNum += "৫"; break;
      case '6': banglaNum += "৬"; break;
      case '7': banglaNum += "৭"; break;
      case '8': banglaNum += "৮"; break;
      case '9': banglaNum += "৯"; break;
      default: banglaNum += c; break;
    }
  }
  return banglaNum;
}

void setup() {
  Serial.begin(115200);
  Wire.begin(21, 22);

  if(!display.begin(0x3C, true)) {
    Serial.println("SH1106 allocation failed");
    for(;;);
  }

  u8g2Fonts.begin(display);
  u8g2Fonts.setFont(u8g2_font_unifont_t_bengali);
  u8g2Fonts.setFontMode(1);
  u8g2Fonts.setFontDirection(0);
  u8g2Fonts.setForegroundColor(SH110X_WHITE);

  if (!rtc.begin()) {
    display.clearDisplay();
    display.setCursor(10, 30);
    display.print("RTC Not Found!");
    display.display();
    while (1) delay(10);
  }

  if (rtc.lostPower()) {
    rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));
  }
}

void loop() {
  DateTime now = rtc.now();

  int h12 = now.hour() % 12;
  if (h12 == 0) h12 = 12;
  String ampm = (now.hour() >= 12) ? "PM" : "AM";

  display.clearDisplay();
  display.setTextColor(SH110X_WHITE);
  
  // ১. তারিখ প্রিন্ট (ছোট পিক্সেল আর্ট)
  drawSmallBanglaDate(now.day(), now.month(), now.year(), 30, 5);

  // ২. মেইন সময় প্রিন্ট (বড় বাংলা ফন্ট)
  String timeStr = getBanglaNumBig(h12) + ":" + getBanglaNumBig(now.minute()) + ":" + getBanglaNumBig(now.second());
  int timeWidth = u8g2Fonts.getUTF8Width(timeStr.c_str());
  int totalTimeWidth = timeWidth + 4 + 12; 
  int timeX = (128 - totalTimeWidth) / 2;

  u8g2Fonts.setCursor(timeX, 38); 
  u8g2Fonts.print(timeStr);

  // ৩. AM/PM প্রিন্ট
  display.setTextSize(1);
  display.setCursor(timeX + timeWidth + 4, 26); 
  display.print(ampm); 

  // ৪. বারের নাম প্রিন্ট (64x16 সাইজের বড় বিটম্যাপ দিয়ে, স্ক্রিনের নিচে মাঝখানে)
  int dayIndex = now.dayOfTheWeek(); 
  int dayX = (128 - 64) / 2; // বিটম্যাপ উইথ ৬৪ পিক্সেল হলে মাঝখানে আনার হিসাব
  display.drawBitmap(dayX, 48, banglaDayBitmaps[dayIndex], 64, 16, SH110X_WHITE);

  display.display();
  delay(1000); 
}